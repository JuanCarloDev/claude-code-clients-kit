# Claude Code — env template
# Copiar pra ~/.claude/.env e preencher
# chmod 600 ~/.claude/.env  (NÃO commitar)

# === OBRIGATÓRIO ===
ANTHROPIC_API_KEY=sk-ant-...

# === OPCIONAIS — só se usa MCPs específicos ===

# Context7 (docs scraping)
# CONTEXT7_API_KEY=

# OpenAI fallback
# OPENAI_API_KEY=

# Google (Gmail/Calendar via OAuth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub (gh CLI já cuida disso normalmente)
# GITHUB_TOKEN=

# === FLAGS ===

# Modelo específico (override default)
# CLAUDE_MODEL=claude-sonnet-4-6

# Telemetria (opt-out)
# DISABLE_TELEMETRY=true
